# Пример конфигурации. Скопируйте в .env и впишите ключ одного провайдера.
# Файл .env в репозиторий не попадает (см. .gitignore). Ключи нельзя коммитить.

# Google Gemini — бесплатный тариф, ключ выдаётся на https://aistudio.google.com/ (кнопка «Get API key»)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# OpenAI и совместимые API (OpenRouter, DeepSeek, vLLM): при необходимости задайте OPENAI_BASE_URL
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Локальная модель через Ollama — документ не покидает контур
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5-coder:7b

# LM Studio, vLLM, llama.cpp и другие локальные серверы с OpenAI-совместимым API:
# OPENAI_BASE_URL=http://localhost:1234/v1
# OPENAI_API_KEY=local
# OPENAI_MODEL=<имя модели на сервере>

# Любая команда, которая читает запрос из стандартного ввода и печатает ответ
# (локальная модель или командная строка другого агента):
# DALEL_PROVIDER=cli
# DALEL_CLI_CMD=ollama run qwen2.5:14b

# Явный выбор провайдера: gemini | openai | anthropic | ollama | claude-cli | cli
# claude-cli использует установленный Claude Code CLI и не требует ключа
# DALEL_PROVIDER=
# DALEL_CLAUDE_MODEL=sonnet
