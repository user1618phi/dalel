        {
          "ruleId": "set_complete",
          "ruleIndex": 1,
          "level": "warning",
          "message": {
            "text": "Не закрыт перечень операций, входящих в расходы. Ф-2 включает покупки и исключает переводы и снятие наличных, но не говорит, по какому признаку смежной системы операция относится к классу. Комиссии, оплата услуг в приложении, квази-кэш и пополнения не отнесены ни к одной группе. Тестировщик не сможет определить ожидаемый счётчик для таких операций."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/requirements.md"
                },
                "region": {
                  "startLine": 38,
                  "endLine": 38,
                  "snippet": {
                    "text": "В расходы входят проведённые покупки."
                  }
                }
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/requirements.md"
                },
                "region": {
                  "startLine": 38,
                  "endLine": 38,
                  "snippet": {
                    "text": "Переводы и снятие наличных исключаются."
                  }
                }
              }
            }
          ],
          "properties": {
            "findingId": "D-010",
            "severity": "major",
