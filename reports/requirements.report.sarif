        {
          "ruleId": "set_validatable",
          "ruleIndex": 5,
          "level": "warning",
          "message": {
            "text": "Значительную часть функциональных требований не проверяет ни один критерий приёмки. Три критерия приёмки проверяют достижение порога, отнесение к месяцу и исключение перевода. Не проверяются: Ф-4 (смена порога), возвраты, снятие наличных, лимит в один push за месяц, выключенное по умолчанию уведомление, повторная доставка события, а также поведение API при отклонённой сумме и чужой карте. Приёмка может пройти, даже если эти правила не реализованы."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/requirements.md"
                },
                "region": {
                  "startLine": 40,
                  "endLine": 40,
                  "snippet": {
                    "text": "При изменении порога накопленная сумма сохраняется."
                  }
                }
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/requirements.md"
                },
                "region": {
                  "startLine": 38,
                  "endLine": 38,
                  "snippet": {
                    "text": "Переводы и снятие наличных исключаются."
                  }
                }
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/requirements.md"
                },
                "region": {
                  "startLine": 52,
                  "endLine": 52,
                  "snippet": {
                    "text": "Повторная доставка одного события процессинга сохраняет исходный итог."
                  }
                }
              }
            }
          ],
          "properties": {
            "findingId": "D-012",
            "severity": "major",
            "criterion": "set_validatable",
