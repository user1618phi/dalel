          }
        },
        {
          "ruleId": "unambiguous",
          "ruleIndex": 7,
          "level": "warning",
          "message": {
            "text": "Не определено, что считается изменением порога. Неясно, считается ли изменением повторное сохранение того же значения или переключение уведомления без смены суммы. Если считается, клиент может получать повторные push, просто нажимая «Сохранить»."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/requirements.md"
                },
                "region": {
                  "startLine": 40,
