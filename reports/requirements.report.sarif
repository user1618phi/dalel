          }
        },
        {
          "ruleId": "set_validatable",
          "ruleIndex": 5,
          "level": "warning",
          "message": {
            "text": "Возврат, снятие наличных, выключение по умолчанию и повторное событие без критериев. Критерии приёмки не проверяют, что возврат уменьшает расходы месяца исходной покупки, что снятие наличных исключается и что по умолчанию уведомление выключено. Не проверяется и то, что повторная доставка события не меняет итог, и что push передаётся на отправку в течение минуты. Из правил Ф-2 проверено только исключение перевода."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/requirements.md"
                },
                "region": {
                  "startLine": 38,
                  "endLine": 38,
                  "snippet": {
                    "text": "Возврат уменьшает расходы месяца исходной покупки."
                  }
                }
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/requirements.md"
                },
                "region": {
                  "startLine": 38,
                  "endLine": 38,
                  "snippet": {
                    "text": "Переводы и снятие наличных исключаются."
                  }
                }
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/requirements.md"
                },
                "region": {
                  "startLine": 37,
                  "endLine": 37,
                  "snippet": {
                    "text": "По умолчанию уведомление выключено."
                  }
                }
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/requirements.md"
                },
                "region": {
                  "startLine": 52,
                  "endLine": 52,
                  "snippet": {
                    "text": "Повторная доставка одного события процессинга сохраняет исходный итог."
                  }
                }
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/requirements.md"
                },
                "region": {
                  "startLine": 46,
                  "endLine": 46,
                  "snippet": {
                    "text": "Сервис передаёт push на отправку в течение минуты после получения события."
                  }
                }
              }
            }
          ],
          "properties": {
            "findingId": "D-014",
