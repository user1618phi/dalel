        {
          "ruleId": "set_consistent",
          "ruleIndex": 0,
          "level": "error",
          "message": {
            "text": "Неверная сумма: 200 с ERROR или 400. Логика метода и пример под заголовком 200 возвращают на неверную сумму результат ERROR с текстом «Проверьте сумму». Перечень статусов возвращает 400 при неверно заполненных параметрах. Граница между этими двумя ошибками не проведена, поэтому клиент и тестировщик не знают, какой код ждать."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/requirements.md"
                },
                "region": {
                  "startLine": 121,
                  "endLine": 121,
                  "snippet": {
                    "text": "При отклонении суммы вернуть прежнее состояние и результат ERROR."
                  }
                }
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/requirements.md"
                },
                "region": {
                  "startLine": 163,
                  "endLine": 163,
                  "snippet": {
                    "text": "Ответ в случае, если параметры запроса заполнены неверно."
                  }
                }
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/requirements.md"
                },
                "region": {
                  "startLine": 171,
                  "endLine": 171,
                  "snippet": {
                    "text": "{\"result\":\"ERROR\",\"message\":\"Проверьте сумму\"}"
                  }
                }
              }
            }
          ],
