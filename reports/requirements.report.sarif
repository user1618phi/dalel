                "artifactLocation": {
                  "uri": "docs/requirements.md"
                },
                "region": {
                  "startLine": 38,
                  "endLine": 38,
                  "snippet": {
                    "text": "Возврат уменьшает расходы месяца исходной покупки."
                  }
                }
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/requirements.md"
                },
                "region": {
                  "startLine": 38,
