                },
                "region": {
                  "startLine": 38,
                  "endLine": 38,
                  "snippet": {
                    "text": "**Ф-2.** Месяц определяется по дате совершения покупки в Алматы."
                  }
                }
              }
            }
          ],
          "properties": {
            "findingId": "D-062",
            "severity": "minor",
