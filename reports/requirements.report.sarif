        {
          "ruleId": "set_comprehensible",
          "ruleIndex": 29,
          "level": "note",
          "message": {
            "text": "Сумма расходов за месяц называется по-разному: расходы, сумма, итог, счётчик. Один и тот же агрегат называется «расходы месяца», «накопленная сумма», «накопленные расходы», «сумма за месяц», «итог» и «счётчик». Нигде не сказано, что это одно значение, а не, например, сумма проведённых операций и отдельный счётчик на экране. Неясно и то, что именно показывает экран и с чем сверяет тестировщик."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/requirements.md"
                },
                "region": {
                  "startLine": 38,
                  "endLine": 38,
                  "snippet": {
                    "text": "Возврат уменьшает расходы месяца исходной покупки."
                  }
                }
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/requirements.md"
                },
                "region": {
                  "startLine": 40,
                  "endLine": 40,
                  "snippet": {
                    "text": "При изменении порога накопленная сумма сохраняется."
                  }
                }
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/requirements.md"
                },
                "region": {
                  "startLine": 29,
                  "endLine": 29,
                  "snippet": {
                    "text": "сумма за месяц и кнопка «Сохранить»"
                  }
                }
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/requirements.md"
                },
                "region": {
                  "startLine": 64,
                  "endLine": 64,
                  "snippet": {
                    "text": "Февральский счётчик вырос на 4 000 ₸"
                  }
                }
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/requirements.md"
                },
                "region": {
                  "startLine": 63,
                  "endLine": 63,
                  "snippet": {
                    "text": "Итог 50 000 ₸ и один push"
                  }
                }
              }
            }
