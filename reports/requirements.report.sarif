          "message": {
            "text": "В разделе статуса 403 описан ответ 404. Раздел называется по коду 403, но текст говорит, что возвращается 404. Остаётся неизвестным, существует ли ответ 403 вообще и в каком случае он возвращается."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/requirements.md"
                },
                "region": {
                  "startLine": 189,
                  "endLine": 189,
                  "snippet": {
                    "text": "Для чужой карты возвращается 404, как и для отсутствующей карты."
                  }
                }
              }
            }
          ],
          "properties": {
            "findingId": "D-042",
            "severity": "major",
            "criterion": "set_consistent",
