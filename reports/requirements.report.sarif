        {
          "ruleId": "set_complete",
          "ruleIndex": 1,
          "level": "warning",
          "message": {
            "text": "Не описано поведение для неактивной, заблокированной или не тенговой карты. Ф-1 разрешает настройку только держателю активной карты KZT, но метод проверяет лишь принадлежность карты клиенту. Не определено, какой ответ вернёт сохранение для заблокированной или долларовой карты. Не определено и то, что происходит с настройкой, счётчиком и push, если карту заблокировали, закрыли или перевыпустили в середине месяца, после того как порог был задан."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/requirements.md"
                },
                "region": {
                  "startLine": 37,
                  "endLine": 37,
                  "snippet": {
                    "text": "Держатель активной карты KZT задаёт целый порог"
                  }
                }
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/requirements.md"
                },
                "region": {
                  "startLine": 118,
                  "endLine": 118,
                  "snippet": {
                    "text": "Проверить принадлежность карты клиенту."
                  }
                }
              }
            }
          ],
          "properties": {
