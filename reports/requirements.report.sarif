                  "snippet": {
                    "text": "Держатель активной карты KZT задаёт целый порог от 1 000 до 1 000 000 ₸ включительно."
                  }
                }
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/requirements.md"
                },
                "region": {
                  "startLine": 118,
                  "endLine": 118,
                  "snippet": {
                    "text": "Проверить принадлежность карты клиенту."
                  }
                }
              }
            }
          ],
          "properties": {
