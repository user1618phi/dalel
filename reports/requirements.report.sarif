        {
          "ruleId": "set_complete",
          "ruleIndex": 1,
          "level": "warning",
          "message": {
            "text": "Нет поведения при недоступности сервиса настроек или учёта расходов. Обработка покупки зависит от запроса порога в сервис настроек, а push нужно передать в течение минуты. Не описано, что происходит с событием, если сервис настроек или учёт расходов недоступен: повтор, отложенная обработка или пропуск. Не сказано и то, считается ли нарушением срока push, переданный после восстановления сервиса."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/requirements.md"
                },
                "region": {
                  "startLine": 26,
                  "endLine": 26,
                  "snippet": {
                    "text": "Мобильное приложение → сервис настроек. Карточный процессинг → учёт расходов → сервис push."
                  }
                }
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/requirements.md"
                },
                "region": {
                  "startLine": 46,
                  "endLine": 46,
                  "snippet": {
                    "text": "Сервис передаёт push на отправку в течение минуты после получения события."
                  }
                }
              }
            }
          ],
          "properties": {
