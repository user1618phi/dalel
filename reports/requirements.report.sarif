        {
          "ruleId": "set_consistent",
          "ruleIndex": 0,
          "level": "warning",
          "message": {
            "text": "Цель «в момент покупки» несовместима с учётом только проведённых покупок. Цель — сообщить клиенту о достижении бюджета в момент покупки. По Ф-2 в расходы входят только проведённые покупки, а в sequence-диаграмме событием служит «проведена покупка». Минута по НФТ отсчитывается от этого события. Поэтому push приходит после клиринга, который бывает через несколько дней после авторизации, а не во время покупки."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/requirements.md"
                },
                "region": {
                  "startLine": 23,
                  "endLine": 23,
                  "snippet": {
                    "text": "Дать клиенту возможность узнать о достижении личного бюджета в момент покупки."
                  }
                }
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/requirements.md"
                },
                "region": {
                  "startLine": 38,
                  "endLine": 38,
                  "snippet": {
                    "text": "В расходы входят проведённые покупки."
                  }
                }
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/requirements.md"
                },
                "region": {
                  "startLine": 43,
                  "endLine": 43,
                  "snippet": {
                    "text": "Процессинг → сервис расходов: проведена покупка."
                  }
                }
              }
            }
          ],
          "properties": {
            "findingId": "D-007",
            "severity": "major",
