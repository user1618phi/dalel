              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/requirements.md"
                },
                "region": {
                  "startLine": 39,
                  "endLine": 39,
                  "snippet": {
                    "text": "**Ф-3.** Когда расходы переходят от суммы ниже порога к сумме, равной порогу или выше, клиент получает push."
                  }
                }
              }
            }
          ],
          "properties": {
