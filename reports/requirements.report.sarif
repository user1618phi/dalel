        {
          "ruleId": "C-001",
          "ruleIndex": 9,
          "level": "warning",
          "message": {
            "text": "Суммы заданы в разных единицах: тиын и тенге. Одни суммы хранятся или передаются в тиынах, другие — в тенге, а правило пересчёта (1 ₸ = 100 тиын) и единица сравнения не названы. Сравнение таких значений без пересчёта ошибается в 100 раз."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/requirements.md"
                },
                "region": {
                  "startLine": 49,
                  "endLine": 49,
                  "snippet": {
                    "text": "Хранить идентификатор карты, месяц, идентификатор операции, сумму покупки в тиынах, признак отправки и порог в тенге."
                  }
                }
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/requirements.md"
                },
                "region": {
                  "startLine": 124,
                  "endLine": 124,
                  "snippet": {
                    "text": "Целое число тенге, обе границы включены."
                  }
                }
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/requirements.md"
                },
                "region": {
                  "startLine": 143,
                  "endLine": 143,
                  "snippet": {
                    "text": "`amount` | integer | 32 bit | Да | 1 000–1 000 000 | Порог в тенге | `limit_kzt`"
                  }
                }
              }
            }
          ],
          "properties": {
