          }
        },
        {
          "ruleId": "set_complete",
          "ruleIndex": 1,
          "level": "note",
          "message": {
            "text": "Не определено «прежнее состояние» при отклонении первого сохранения. При отклонении суммы метод должен вернуть прежнее состояние, но при первом сохранении действующей настройки ещё нет. Пример: клиент впервые сохраняет порог 999 ₸. Неясно, какие amount и enabled вернутся в ответе и останется ли настройка несозданной."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/requirements.md"
                },
                "region": {
                  "startLine": 121,
                  "endLine": 121,
                  "snippet": {
                    "text": "При отклонении суммы вернуть прежнее состояние и результат ERROR."
                  }
                }
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/requirements.md"
                },
                "region": {
                  "startLine": 125,
                  "endLine": 125,
                  "snippet": {
                    "text": "Повторное сохранение заменяет действующую настройку."
                  }
                }
              }
            }
          ],
          "properties": {
            "findingId": "D-060",
            "severity": "minor",
            "criterion": "set_complete",
            "status": "confirmed",
