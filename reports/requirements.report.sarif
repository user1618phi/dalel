          }
        },
        {
          "ruleId": "F-004",
          "ruleIndex": 21,
          "level": "warning",
          "message": {
            "text": "Не описан частичный возврат и судьба уже отправленного уведомления. Возврат упомянут, но не сказано, как учитывается возврат части суммы и что происходит с уже отправленным уведомлением, если после возврата накопленная сумма снова ниже порога, а затем опять его достигает."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/requirements.md"
                },
                "region": {
                  "startLine": 38,
                  "endLine": 38,
                  "snippet": {
                    "text": "Возврат уменьшает расходы месяца исходной покупки."
