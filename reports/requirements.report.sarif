        {
          "ruleId": "set_complete",
          "ruleIndex": 1,
          "level": "warning",
          "message": {
            "text": "Не описана недоступность сервиса настроек или учёта расходов. Цепочка процессинг → учёт расходов → настройки → push не описывает ошибку на промежуточных шагах. Если сервис настроек не ответил, неизвестно, будет ли событие повторено, отложено или потеряно. Неизвестно и то, будет ли учтена покупка и отправлен ли push позже. Требование «в течение минуты» для этого случая не определено."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/requirements.md"
                },
                "region": {
                  "startLine": 26,
                  "endLine": 26,
                  "snippet": {
                    "text": "Карточный процессинг → учёт расходов → сервис push."
                  }
                }
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/requirements.md"
                },
                "region": {
                  "startLine": 43,
                  "endLine": 43,
                  "snippet": {
                    "text": "Сервис расходов → настройки: получить порог карты."
                  }
                }
              }
            }
          ],
          "properties": {
