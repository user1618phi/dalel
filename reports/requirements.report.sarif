        {
          "ruleId": "set_complete",
          "ruleIndex": 1,
          "level": "warning",
          "message": {
            "text": "Не разграничено, когда метод отвечает 400, а когда result=ERROR. Отклонённая сумма даёт результат ERROR, а неверно заполненные параметры — статус 400, но граница между этими случаями не задана. Неясно, какой ответ получат запросы с enabled=2, amount=50000.5, amount=abc, без amount или с cardId длиной 65 символов. Также не сказано, что показывает экран в каждом из этих случаев."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/requirements.md"
                },
                "region": {
                  "startLine": 121,
                  "endLine": 121,
                  "snippet": {
                    "text": "При отклонении суммы вернуть прежнее состояние и результат ERROR."
                  }
                }
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/requirements.md"
                },
                "region": {
                  "startLine": 163,
                  "endLine": 163,
                  "snippet": {
                    "text": "Ответ в случае, если параметры запроса заполнены неверно."
                  }
                }
              }
            }
