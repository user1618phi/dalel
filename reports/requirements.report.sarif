        {
          "ruleId": "set_consistent",
          "ruleIndex": 0,
          "level": "note",
          "message": {
            "text": "Цель обещает push в момент покупки, а Ф-2 и НФТ допускают задержку. Цель — сообщить клиенту о достижении бюджета в момент покупки. Ф-2 учитывает только проведённые покупки, критерий приёмки показывает проведение через несколько минут после покупки, а НФТ даёт ещё минуту после получения события. Если НФТ выполнено, цель всё равно не достигнута."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/requirements.md"
                },
                "region": {
                  "startLine": 23,
                  "endLine": 23,
                  "snippet": {
                    "text": "Дать клиенту возможность узнать о достижении личного бюджета в момент покупки."
                  }
                }
              }
