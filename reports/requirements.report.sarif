          }
        },
        {
          "ruleId": "set_complete",
          "ruleIndex": 1,
          "level": "warning",
          "message": {
            "text": "Не описано поведение для неактивной, заблокированной, закрытой карты и карты не в KZT. Ф-1 разрешает задавать порог только держателю активной карты KZT, но шаги метода проверяют лишь принадлежность карты. Неизвестно, что API вернёт для заблокированной или валютной карты. Также не сказано, что происходит с уже включённым уведомлением и счётчиком, если карту блокируют или закрывают посреди месяца, а потом разблокируют."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/requirements.md"
                },
                "region": {
                  "startLine": 37,
                  "endLine": 37,
                  "snippet": {
                    "text": "Держатель активной карты KZT задаёт целый порог от 1 000 до 1 000 000 ₸ включительно."
                  }
                }
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/requirements.md"
                },
                "region": {
                  "startLine": 118,
                  "endLine": 118,
                  "snippet": {
