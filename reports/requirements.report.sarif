        },
        {
          "ruleId": "complete",
          "ruleIndex": 6,
          "level": "note",
          "message": {
            "text": "В процессе нет ветвлений для выключенного уведомления и уже отправленного push. Схема ведёт к отправке push при любом достижении порога. В ней нет проверки, включено ли уведомление и был ли push в этом месяце. Если реализовать схему как написано, push может уйти выключившему уведомление клиенту или прийти повторно."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/requirements.md"
                },
                "region": {
                  "startLine": 34,
                  "endLine": 34,
                  "snippet": {
                    "text": "при достижении отправка push → завершение"
                  }
                }
              }
            }
          ],
          "properties": {
