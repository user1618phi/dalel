          }
        },
        {
          "ruleId": "complete",
          "ruleIndex": 9,
          "level": "note",
          "message": {
            "text": "Правило не называет ни параметр, ни сами границы. В правиле нет предмета и числовых границ: читатель должен сам догадаться, что речь о пороге и о каком диапазоне. Отдельно правило проверить нельзя, а при изменении диапазона в другом месте оно станет неверным незаметно."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/requirements.md"
                },
                "region": {
                  "startLine": 124,
                  "endLine": 124,
                  "snippet": {
                    "text": "Целое число тенге, обе границы включены."
                  }
                }
              }
            }
          ],
