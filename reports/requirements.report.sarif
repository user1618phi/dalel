                },
                "region": {
                  "startLine": 52,
                  "endLine": 52,
                  "snippet": {
                    "text": "Приложение читает и сохраняет настройки через дочерний документ «Уведомление о расходах по карте — REST API»."
                  }
                }
              }
            }
          ],
