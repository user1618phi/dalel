        {
          "ruleId": "set_complete",
          "ruleIndex": 1,
          "level": "warning",
          "message": {
            "text": "Не описаны блокировка, закрытие и перевыпуск карты посреди месяца. Данные и правило привязаны к идентификатору карты. Неясно, что происходит с настройкой, счётчиком и признаком отправки, если карту заблокировали, закрыли или перевыпустили с новым идентификатором. Пример: 40 000 ₸ потрачено по старой карте, 15 000 ₸ — по новой, порог 50 000 ₸. Неясно, отправлять ли push."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/requirements.md"
                },
                "region": {
                  "startLine": 49,
                  "endLine": 49,
                  "snippet": {
                    "text": "Хранить идентификатор карты, месяц, идентификатор операции"
                  }
                }
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/requirements.md"
                },
                "region": {
                  "startLine": 39,
                  "endLine": 39,
                  "snippet": {
                    "text": "На карту приходится максимум один такой push за календарный месяц."
                  }
                }
              }
            }
          ],
          "properties": {
            "findingId": "D-015",
