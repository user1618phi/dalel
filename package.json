{
  "name": "dalel",
  "version": "0.1.0",
  "description": "Dalel — агент статической проверки требований: каждая находка с доказательством. ISO/IEC/IEEE 29148, IEEE 830, финтех-пакет правил.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22.12" },
  "bin": { "dalel": "bin/dalel.mjs" },
  "files": ["bin", "dist", "src", "packs", "skills", "README.md", "LICENSE"],
  "scripts": {
    "check": "node bin/dalel.mjs",
    "dalel": "node bin/dalel.mjs",
    "eval": "node bin/dalel.mjs eval",
    "coverage": "node bin/dalel.mjs coverage",
    "serve": "node bin/dalel.mjs serve",
    "mcp": "node bin/dalel.mjs mcp",
    "doctor": "node bin/dalel.mjs doctor",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "dejavu-fonts-ttf": "^2.37.3",
    "mammoth": "^1.13.0",
    "pdfmake": "0.2.23",
    "tsx": "^4.23.15",
    "unpdf": "^2.2.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pdfmake": "^0.2.11",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
